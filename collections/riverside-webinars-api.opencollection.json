{
  "opencollection": "1.0.0",
  "info": {
    "name": "Riverside Business Exports Webinars API",
    "version": "v3"
  },
  "items": [
    {
      "info": {
        "name": "Webinars",
        "type": "folder"
      },
      "items": [
        {
          "info": {
